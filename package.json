{
  "name": "syntaxai-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:chrome",
    "build:chrome": "tsc -b && vite build",
    "build:firefox": "tsc -b && vite build --mode firefox",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "firefox:run": "npm run build:firefox && web-ext run --source-dir dist-firefox",
    "typecheck": "tsc -b",
    "icons:generate": "python3 scripts/generate-extension-icons.py"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.329",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  }
}
