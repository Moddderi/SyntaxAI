{
  "manifest_version": 3,
  "name": "SyntaxAI",
  "description": "AI-powered developer notebook — capture, organize, and search your code snippets.",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "syntaxai@syntaxai.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "websiteContent",
          "browsingActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SyntaxAI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_title": "SyntaxAI",
    "default_panel": "src/sidepanel/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/dashboard/index.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab", "contextMenus", "alarms"],
  "host_permissions": [
    "https://syntaxai.app/*",
    "https://www.syntaxai.app/*",
    "https://api.syntaxai.app/*"
  ],
  "commands": {
    "capture-context": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture selected text and page context into SyntaxAI"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://syntaxai.app/*", "https://www.syntaxai.app/*"],
      "js": ["content/authHandoff.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.syntaxai.app; img-src 'self' data: https://cdn.jsdelivr.net;"
  }
}
